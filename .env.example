# Copy these into Render -> Environment (never commit real values)
NODE_ENV=production
TRUST_PROXY=1
SITE_URL=https://your-app.onrender.com

# Turso
TURSO_DATABASE_URL=libsql://your-db-name-your-user.turso.io
TURSO_AUTH_TOKEN=paste-token-here

# Admin account (created automatically on first start)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-unique-password
ADMIN_NAME=admin
